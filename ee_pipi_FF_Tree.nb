Notebook[{
Cell["Tensor Decomposition for e+e- \[LongRightArrow] \[Pi]+\[Pi]- at LO \
(optimised)", "Title",ExpressionUUID->"463459fb-2ea2-4b06-a327-fee52029363a"],

Cell["\<\
Scalar QED amplitude for e+(p1) e-(p2) \[LongRightArrow] \[Pi]+(p3) \
\[Pi]-(p4), decomposed onto a basis of two Dirac structures by solving G.F = \
B, where G is the Gram matrix of the basis and B the projection of the \
amplitude onto it. Expected result: F1 = -2e^2/s and F2 = 0 (the scalar \
structure needs a helicity flip and only appears beyond LO).\
\>", "Text",ExpressionUUID->"b09287f1-84e9-4770-ae1e-365003abc488"],

Cell["1. Packages", "Section",ExpressionUUID->"8ba2596d-db33-449a-82b5-973390e5a20b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$FeynCalcStartupMessages", " ", "=", " ", "False"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$LoadAddOns", " ", "=", " ", 
   RowBox[{"{", "\"\<FeynArts\>\"", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Get", "[", "\"\<FeynCalc`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$FAVerbose", " ", "=", " ", "0"}], ";"}]}], "Input",ExpressionUUID->\
"2f2f9438-023b-414b-8573-710fff6b2808"],

Cell["2. Kinematics", "Section",ExpressionUUID->"cbf3836c-af9f-49f2-8990-1690dcbbe30d"],

Cell["\<\
SetMandelstam fixes all ten scalar products at once (momenta taken as \
incoming, hence -p3, -p4). The fourth invariant is passed directly as 2me^2 + \
2m\[Pi]^2 - s - t, so u never appears in the results. The masses are the \
plain symbols me and mpi; the FeynArts masses are mapped onto them when the \
amplitude is converted.\
\>", "Text",ExpressionUUID->"44edc938-d9d1-491c-b8b2-361f83c05a71"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"FCClearScalarProducts", "[", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetMandelstam", "[", 
   RowBox[{"s", ",", " ", "t", ",", " ", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"me", "^", "2"}]}], " ", "+", " ", 
     RowBox[{"2", " ", 
      RowBox[{"mpi", "^", "2"}]}], " ", "-", " ", "s", " ", "-", " ", "t"}], ",",
     " ", "p1", ",", " ", "p2", ",", " ", 
    RowBox[{"-", "p3"}], ",", " ", 
    RowBox[{"-", "p4"}], ",", " ", "me", ",", " ", "me", ",", " ", "mpi", ",",
     " ", "mpi"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", 
   RowBox[{
    RowBox[{"s", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"me", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"mpi", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"m12", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"m32", " ", ">", " ", "0"}]}]}], ";"}]}], "Input",ExpressionUUID->\
"fc9b9c01-9a86-47be-9bb1-fd17499049d7"],

Cell["3. Amplitude from FeynArts", "Section",ExpressionUUID->"ea376ec7-c353-4388-9e62-3edb48cf797d"],

Cell["\<\
FeynArts has no built-in scalar QED model. The charged Goldstone boson S[3] \
of the SM model couples to the photon exactly like a charged scalar, so \
excluding the Z, W, Higgs, neutral Goldstone, ghosts, and all other fermions \
leaves pure sQED; the Goldstone and electron masses are renamed to mpi and me \
via FinalSubstitutions. The electric charge is kept symbolic.\
\>", "Text",ExpressionUUID->"48c021a0-f583-407d-9dac-4b0517a2a737"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tops", " ", "=", " ", 
   RowBox[{"CreateTopologies", "[", 
    RowBox[{"0", ",", " ", 
     RowBox[{"2", " ", "->", " ", "2"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"diags", " ", "=", " ", 
   RowBox[{"InsertFields", "[", 
    RowBox[{"tops", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"F", "[", 
          RowBox[{"2", ",", " ", 
           RowBox[{"{", "1", "}"}]}], "]"}]}], ",", " ", 
        RowBox[{"F", "[", 
         RowBox[{"2", ",", " ", 
          RowBox[{"{", "1", "}"}]}], "]"}]}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"S", "[", "3", "]"}], ",", " ", 
        RowBox[{"-", 
         RowBox[{"S", "[", "3", "]"}]}]}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"Model", " ", "->", " ", "\"\<SM\>\""}], ",", " ", 
     RowBox[{"InsertionLevel", " ", "->", " ", 
      RowBox[{"{", "Classes", "}"}]}], ",", "\n", "   ", 
     RowBox[{"ExcludeParticles", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"F", "[", "1", "]"}], ",", " ", 
        RowBox[{"F", "[", "3", "]"}], ",", " ", 
        RowBox[{"F", "[", "4", "]"}], ",", " ", 
        RowBox[{"V", "[", "2", "]"}], ",", " ", 
        RowBox[{"V", "[", "3", "]"}], ",", " ", 
        RowBox[{"S", "[", "1", "]"}], ",", " ", 
        RowBox[{"S", "[", "2", "]"}], ",", " ", 
        RowBox[{"U", "[", "1", "]"}], ",", " ", 
        RowBox[{"U", "[", "2", "]"}], ",", " ", 
        RowBox[{"U", "[", "3", "]"}], ",", " ", 
        RowBox[{"U", "[", "4", "]"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Paint", "[", 
   RowBox[{"diags", ",", " ", 
    RowBox[{"ColumnsXRows", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}]}], ",", " ", 
    RowBox[{"Numbering", " ", "->", " ", "None"}], ",", " ", 
    RowBox[{"SheetHeader", " ", "->", " ", "None"}], ",", " ", 
    RowBox[{"ImageSize", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"256", ",", " ", "256"}], "}"}]}]}], "]"}], ";"}]}], "Input",Exp\
ressionUUID->"83d6e93d-e826-45d9-8a99-e8a9d68d2d81"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"amp", " ", "=", " ", 
   RowBox[{"FCFAConvert", "[", 
    RowBox[{
     RowBox[{"CreateFeynAmp", "[", "diags", "]"}], ",", "\n", "   ", 
     RowBox[{"IncomingMomenta", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"p1", ",", " ", "p2"}], "}"}]}], ",", " ", 
     RowBox[{"OutgoingMomenta", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"p3", ",", " ", "p4"}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"UndoChiralSplittings", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"ChangeDimension", " ", "->", " ", "4"}], ",", " ", 
     RowBox[{"List", " ", "->", " ", "False"}], ",", " ", 
     RowBox[{"SMP", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"Contract", " ", "->", " ", "True"}], ",", "\n", "   ", 
     RowBox[{"FinalSubstitutions", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"SMP", "[", "\"\<m_W\>\"", "]"}], " ", "->", " ", "mpi"}], ",",
         " ", 
        RowBox[{
         RowBox[{"SMP", "[", "\"\<m_e\>\"", "]"}], " ", "->", " ", "me"}]}], 
       "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"amp", " ", "=", " ", 
  RowBox[{"DiracSimplify", "[", 
   RowBox[{"FeynAmpDenominatorExplicit", "[", "amp", "]"}], "]"}]}]}], "Input",\
ExpressionUUID->"ce68090f-4b80-49db-9fef-4e1cf90b36da"],

Cell["4. Tensor decomposition", "Section",ExpressionUUID->"02960807-02da-4cbb-90a2-22f62e819017"],

Cell["\<\
Generic helpers: the Gram matrix G_ij = \[Sum]_spins T_i T_j^* and the \
projections B_i = \[Sum]_spins T_i^* M. The form factors follow from \
LinearSolve, which avoids forming the symbolic inverse. Everything is written \
in terms of Length[basis], so adding a structure (e.g. at one loop) needs no \
other change.\
\>", "Text",ExpressionUUID->"e3a672c2-a3b8-421e-b8ca-6b1a1da25e55"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"spinSum", "[", "expr_", "]"}], " ", ":=", " ", 
   RowBox[{"DiracSimplify", "[", 
    RowBox[{"FermionSpinSum", "[", "expr", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gramMatrix", "[", "basis_List", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"spinSum", "[", 
      RowBox[{
       RowBox[{"basis", "[", 
        RowBox[{"[", "i", "]"}], "]"}], " ", 
       RowBox[{"ComplexConjugate", "[", 
        RowBox[{"basis", "[", 
         RowBox[{"[", "j", "]"}], "]"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", 
       RowBox[{"Length", "[", "basis", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", 
       RowBox[{"Length", "[", "basis", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"projections", "[", 
    RowBox[{"amp_", ",", " ", "basis_List"}], "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"spinSum", "[", 
      RowBox[{
       RowBox[{"ComplexConjugate", "[", 
        RowBox[{"basis", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], " ", "amp"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", 
       RowBox[{"Length", "[", "basis", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"formFactors", "[", 
    RowBox[{"amp_", ",", " ", "basis_List"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"G", ",", " ", "B"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"G", " ", "=", " ", 
       RowBox[{"Factor", "[", 
        RowBox[{"gramMatrix", "[", "basis", "]"}], "]"}]}], ";", "\n", "   ", 
      
      RowBox[{"B", " ", "=", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{"projections", "[", 
         RowBox[{"amp", ",", " ", "basis"}], "]"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"G", ",", " ", "B", ",", " ", 
        RowBox[{"Simplify", "[", 
         RowBox[{"LinearSolve", "[", 
          RowBox[{"G", ",", " ", "B"}], "]"}], "]"}]}], "}"}]}]}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"01487646-89ea-406e-94b6-7737765b7482"],

Cell["\<\
Basis. GS[p3] is \[Gamma]\[CenterDot]p3 already contracted, so no dummy \
Lorentz index is needed. Only p3 appears because vbar(p1).(p3+p4)slash.u(p2) \
= vbar(p1).(p1+p2)slash.u(p2) = 0 by the Dirac equation, so (p3-p4)slash is \
equivalent to 2 p3slash between these spinors.\
\>", "Text",ExpressionUUID->"8beb90e1-905a-444a-8cdb-30cdef0cf094"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"vbar", " ", "=", " ", 
   RowBox[{"SpinorVBar", "[", 
    RowBox[{"p1", ",", " ", "me"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"uSp", " ", "=", " ", 
   RowBox[{"SpinorU", "[", 
    RowBox[{"p2", ",", " ", "me"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T1", " ", "=", " ", 
   RowBox[{"vbar", " ", ".", " ", 
    RowBox[{"GS", "[", "p3", "]"}], " ", ".", " ", "uSp"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T2", " ", "=", " ", 
   RowBox[{"vbar", " ", ".", " ", "uSp"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"basis", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"T1", ",", " ", "T2"}], "}"}]}], ";"}]}], "Input",ExpressionUUID->\
"0f704731-9fe1-4e0f-9d1e-93516fa85edd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"G", ",", " ", "Bvec", ",", " ", "Fvec"}], "}"}], " ", "=", " ", 
   RowBox[{"formFactors", "[", 
    RowBox[{"amp", ",", " ", "basis"}], "]"}]}], ";"}], "\n", 
 RowBox[{"G", " ", "//", " ", "MatrixForm"}]}], "Input",ExpressionUUID->\
"fb404d0b-c2a3-4eee-9f08-febb7194a91e"],

Cell[BoxData[
 RowBox[{"Factor", "[", 
  RowBox[{"Det", "[", "G", "]"}], "]"}]], "Input",ExpressionUUID->"0ff873f9-\
6b33-4855-ab14-3122d1af56ae"],

Cell["\<\
The Gram determinant is proportional to the squared momentum of the pion in \
the CM frame, i.e. to s - 4m\[Pi]^2, times the forward/backward factor; the \
decomposition is singular at threshold and in the exactly collinear \
configuration, as it must be.\
\>", "Text",ExpressionUUID->"b13229b8-00e1-4c26-b2ef-96f5b1d9f312"],

Cell[BoxData["Bvec"], "Input",ExpressionUUID->"9f92cd19-6f5b-445c-a4f9-bcdd16ff9527"],

Cell[BoxData["Fvec"], "Input",ExpressionUUID->"ec191127-0a8b-43fb-abd3-1f8a16e4c73d"],

Cell["5. Save", "Section",ExpressionUUID->"a357f89f-0b3d-4a44-b012-fbd410796cbc"],

Cell["\<\
For the saved files the masses are traded for their squares, m12 = me^2 and \
m32 = mpi^2 (me = Sqrt[m12], mpi = Sqrt[m32]); even powers become polynomial \
in m12, m32 and only the helicity-flip terms keep a square root. The Gram \
matrix and the two form factors are written as Mathematica expressions into \
the folder ee_pipi next to the notebook (created if needed), one file per \
form factor.\
\>", "Text",ExpressionUUID->"2417d222-b344-4bb2-b46c-9c8be8ec8ff6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"toMassSquared", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"me", " ", "->", " ", 
      RowBox[{"Sqrt", "[", "m12", "]"}]}], ",", " ", 
     RowBox[{"mpi", " ", "->", " ", 
      RowBox[{"Sqrt", "[", "m32", "]"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Gout", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"G", " ", "/.", " ", "toMassSquared"}], "]"}]}], ";"}], "\n", 
 RowBox[{"FvecOut", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{"Fvec", " ", "/.", " ", "toMassSquared"}], "]"}]}]}], "Input",Expre\
ssionUUID->"45afd477-3442-41a1-81f1-525a78195d4a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"outDir", " ", "=", " ", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Quiet", "[", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
         RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}], ",", 
      " ", "\"\<ee_pipi\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", " ", 
     RowBox[{"DirectoryQ", "[", "outDir", "]"}]}], ",", " ", 
    RowBox[{"CreateDirectory", "[", "outDir", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Put", "[", 
   RowBox[{"Gout", ",", " ", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"outDir", ",", " ", "\"\<Gram_Matrix.m\>\""}], "}"}], "]"}]}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Put", "[", 
     RowBox[{
      RowBox[{"FvecOut", "[", 
       RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"outDir", ",", " ", 
         RowBox[{"\"\<FF_Tree_\>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", "i", "]"}], " ", "<>", 
          " ", "\"\<.m\>\""}]}], "}"}], "]"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", 
      RowBox[{"Length", "[", "basis", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"FileNames", "[", 
  RowBox[{"\"\<*\>\"", ",", " ", "outDir"}], "]"}]}], "Input",ExpressionUUID->\
"a07ca69d-20df-4775-9fe9-8ff7faef0bde"]
},
