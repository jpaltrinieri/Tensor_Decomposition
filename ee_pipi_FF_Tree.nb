Notebook[{
Cell["Tensor Decomposition for e+e- \[LongRightArrow] \[Pi]+\[Pi]- at LO \
(optimised)", "Title",ExpressionUUID->"baa840c9-66e8-4aa4-9f5a-cc52681bf864"],

Cell["\<\
Scalar QED amplitude for e+(p1) e-(p2) \[LongRightArrow] \[Pi]+(p3) \
\[Pi]-(p4), decomposed onto a basis of two Dirac structures by solving G.F = \
B, where G is the Gram matrix of the basis and B the projection of the \
amplitude onto it. Expected result: F1 = -2e^2/s and F2 = 0 (the scalar \
structure needs a helicity flip and only appears beyond LO).\
\>", "Text",ExpressionUUID->"d0ff2a66-d258-4cc9-bf65-2ee73f9df733"],

Cell["1. Packages", "Section",ExpressionUUID->"60d2fdc2-a10c-4874-ac04-004be700691c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$FeynCalcStartupMessages", " ", "=", " ", "False"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$LoadAddOns", " ", "=", " ", 
   RowBox[{"{", "\"\<FeynArts\>\"", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Get", "[", "\"\<FeynCalc`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$FAVerbose", " ", "=", " ", "0"}], ";"}]}], "Input",ExpressionUUID->\
"34ccfd84-7ee1-4248-adc3-a0ad10ceacbb"],

Cell["2. Kinematics", "Section",ExpressionUUID->"1efe4932-c916-4ff3-87df-1fdac38e4063"],

Cell["\<\
SetMandelstam fixes all ten scalar products at once (momenta taken as \
incoming, hence -p3, -p4). The fourth invariant is passed directly as 2me^2 + \
2m\[Pi]^2 - s - t, so u never appears in the results. The masses are the \
plain symbols me and mpi; the FeynArts masses are mapped onto them when the \
amplitude is converted.\
\>", "Text",ExpressionUUID->"4d9f4dc9-09cc-4f1f-a7dd-e418f60a9b71"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"FCClearScalarProducts", "[", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetMandelstam", "[", 
   RowBox[{"s", ",", " ", "t", ",", " ", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"me", "^", "2"}]}], " ", "+", " ", 
     RowBox[{"2", " ", 
      RowBox[{"mpi", "^", "2"}]}], " ", "-", " ", "s", " ", "-", " ", "t"}], ",",
     " ", "p1", ",", " ", "p2", ",", " ", 
    RowBox[{"-", "p3"}], ",", " ", 
    RowBox[{"-", "p4"}], ",", " ", "me", ",", " ", "me", ",", " ", "mpi", ",",
     " ", "mpi"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", 
   RowBox[{
    RowBox[{"s", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"me", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"mpi", " ", ">", " ", "0"}]}]}], ";"}]}], "Input",ExpressionUUID->\
"53a9943c-ef4c-4641-8b51-7fb632d5393c"],

Cell["3. Amplitude from FeynArts", "Section",ExpressionUUID->"757dfe47-a7fd-40e0-931b-903241dff69e"],

Cell["\<\
FeynArts has no built-in scalar QED model. The charged Goldstone boson S[3] \
of the SM model couples to the photon exactly like a charged scalar, so \
excluding the Z, W, Higgs, neutral Goldstone, ghosts, and all other fermions \
leaves pure sQED; the Goldstone and electron masses are renamed to mpi and me \
via FinalSubstitutions. The electric charge is kept symbolic.\
\>", "Text",ExpressionUUID->"55fb2f82-847b-4fb3-baed-9a05fd3b74b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tops", " ", "=", " ", 
   RowBox[{"CreateTopologies", "[", 
    RowBox[{"0", ",", " ", 
     RowBox[{"2", " ", "->", " ", "2"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"diags", " ", "=", " ", 
   RowBox[{"InsertFields", "[", 
    RowBox[{"tops", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"F", "[", 
          RowBox[{"2", ",", " ", 
           RowBox[{"{", "1", "}"}]}], "]"}]}], ",", " ", 
        RowBox[{"F", "[", 
         RowBox[{"2", ",", " ", 
          RowBox[{"{", "1", "}"}]}], "]"}]}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"S", "[", "3", "]"}], ",", " ", 
        RowBox[{"-", 
         RowBox[{"S", "[", "3", "]"}]}]}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"Model", " ", "->", " ", "\"\<SM\>\""}], ",", " ", 
     RowBox[{"InsertionLevel", " ", "->", " ", 
      RowBox[{"{", "Classes", "}"}]}], ",", "\n", "   ", 
     RowBox[{"ExcludeParticles", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"F", "[", "1", "]"}], ",", " ", 
        RowBox[{"F", "[", "3", "]"}], ",", " ", 
        RowBox[{"F", "[", "4", "]"}], ",", " ", 
        RowBox[{"V", "[", "2", "]"}], ",", " ", 
        RowBox[{"V", "[", "3", "]"}], ",", " ", 
        RowBox[{"S", "[", "1", "]"}], ",", " ", 
        RowBox[{"S", "[", "2", "]"}], ",", " ", 
        RowBox[{"U", "[", "1", "]"}], ",", " ", 
        RowBox[{"U", "[", "2", "]"}], ",", " ", 
        RowBox[{"U", "[", "3", "]"}], ",", " ", 
        RowBox[{"U", "[", "4", "]"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Paint", "[", 
   RowBox[{"diags", ",", " ", 
    RowBox[{"ColumnsXRows", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}]}], ",", " ", 
    RowBox[{"Numbering", " ", "->", " ", "None"}], ",", " ", 
    RowBox[{"SheetHeader", " ", "->", " ", "None"}], ",", " ", 
    RowBox[{"ImageSize", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"256", ",", " ", "256"}], "}"}]}]}], "]"}], ";"}]}], "Input",Exp\
ressionUUID->"c123dfba-6ec7-4f0d-951d-3c7582a0b18e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"amp", " ", "=", " ", 
   RowBox[{"FCFAConvert", "[", 
    RowBox[{
     RowBox[{"CreateFeynAmp", "[", "diags", "]"}], ",", "\n", "   ", 
     RowBox[{"IncomingMomenta", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"p1", ",", " ", "p2"}], "}"}]}], ",", " ", 
     RowBox[{"OutgoingMomenta", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"p3", ",", " ", "p4"}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"UndoChiralSplittings", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"ChangeDimension", " ", "->", " ", "4"}], ",", " ", 
     RowBox[{"List", " ", "->", " ", "False"}], ",", " ", 
     RowBox[{"SMP", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"Contract", " ", "->", " ", "True"}], ",", "\n", "   ", 
     RowBox[{"FinalSubstitutions", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"SMP", "[", "\"\<m_W\>\"", "]"}], " ", "->", " ", "mpi"}], ",",
         " ", 
        RowBox[{
         RowBox[{"SMP", "[", "\"\<m_e\>\"", "]"}], " ", "->", " ", "me"}]}], 
       "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"amp", " ", "=", " ", 
  RowBox[{"DiracSimplify", "[", 
   RowBox[{"FeynAmpDenominatorExplicit", "[", "amp", "]"}], "]"}]}]}], "Input",\
ExpressionUUID->"679508bf-c28d-4d6f-98fc-9ca9db511057"],

Cell["4. Tensor decomposition", "Section",ExpressionUUID->"2bb2b369-fc8d-4ecf-b665-fb7d9d96f69b"],

Cell["\<\
Generic helpers: the Gram matrix G_ij = \[Sum]_spins T_i T_j^* and the \
projections B_i = \[Sum]_spins T_i^* M. The form factors follow from \
LinearSolve, which avoids forming the symbolic inverse. Everything is written \
in terms of Length[basis], so adding a structure (e.g. at one loop) needs no \
other change.\
\>", "Text",ExpressionUUID->"f216ddf6-f2c7-4f91-9546-e36a536e19d0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"spinSum", "[", "expr_", "]"}], " ", ":=", " ", 
   RowBox[{"DiracSimplify", "[", 
    RowBox[{"FermionSpinSum", "[", "expr", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gramMatrix", "[", "basis_List", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"spinSum", "[", 
      RowBox[{
       RowBox[{"basis", "[", 
        RowBox[{"[", "i", "]"}], "]"}], " ", 
       RowBox[{"ComplexConjugate", "[", 
        RowBox[{"basis", "[", 
         RowBox[{"[", "j", "]"}], "]"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", 
       RowBox[{"Length", "[", "basis", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", 
       RowBox[{"Length", "[", "basis", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"projections", "[", 
    RowBox[{"amp_", ",", " ", "basis_List"}], "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"spinSum", "[", 
      RowBox[{
       RowBox[{"ComplexConjugate", "[", 
        RowBox[{"basis", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], " ", "amp"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", 
       RowBox[{"Length", "[", "basis", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"formFactors", "[", 
    RowBox[{"amp_", ",", " ", "basis_List"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"G", ",", " ", "B"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"G", " ", "=", " ", 
       RowBox[{"Factor", "[", 
        RowBox[{"gramMatrix", "[", "basis", "]"}], "]"}]}], ";", "\n", "   ", 
      
      RowBox[{"B", " ", "=", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{"projections", "[", 
         RowBox[{"amp", ",", " ", "basis"}], "]"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"G", ",", " ", "B", ",", " ", 
        RowBox[{"Simplify", "[", 
         RowBox[{"LinearSolve", "[", 
          RowBox[{"G", ",", " ", "B"}], "]"}], "]"}]}], "}"}]}]}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"83434d13-9870-4098-b756-eee14c59b893"],

Cell["\<\
Basis. GS[p3] is \[Gamma]\[CenterDot]p3 already contracted, so no dummy \
Lorentz index is needed. Only p3 appears because vbar(p1).(p3+p4)slash.u(p2) \
= vbar(p1).(p1+p2)slash.u(p2) = 0 by the Dirac equation, so (p3-p4)slash is \
equivalent to 2 p3slash between these spinors.\
\>", "Text",ExpressionUUID->"5a4735d1-79a0-4b15-8bd1-b9af62696db4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"vbar", " ", "=", " ", 
   RowBox[{"SpinorVBar", "[", 
    RowBox[{"p1", ",", " ", "me"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"uSp", " ", "=", " ", 
   RowBox[{"SpinorU", "[", 
    RowBox[{"p2", ",", " ", "me"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T1", " ", "=", " ", 
   RowBox[{"vbar", " ", ".", " ", 
    RowBox[{"GS", "[", "p3", "]"}], " ", ".", " ", "uSp"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T2", " ", "=", " ", 
   RowBox[{"vbar", " ", ".", " ", "uSp"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"basis", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"T1", ",", " ", "T2"}], "}"}]}], ";"}]}], "Input",ExpressionUUID->\
"1f1ce740-c30c-45ac-acb8-5a3e4bf91ef2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"G", ",", " ", "Bvec", ",", " ", "Fvec"}], "}"}], " ", "=", " ", 
   RowBox[{"formFactors", "[", 
    RowBox[{"amp", ",", " ", "basis"}], "]"}]}], ";"}], "\n", 
 RowBox[{"G", " ", "//", " ", "MatrixForm"}]}], "Input",ExpressionUUID->\
"a7311594-db9a-4f01-a2fb-61f4279b0e1d"],

Cell[BoxData[
 RowBox[{"Factor", "[", 
  RowBox[{"Det", "[", "G", "]"}], "]"}]], "Input",ExpressionUUID->"506bb712-\
2dd8-4f55-9b75-c4286bf40a0a"],

Cell["\<\
The Gram determinant is proportional to the squared momentum of the pion in \
the CM frame, i.e. to s - 4m\[Pi]^2, times the forward/backward factor; the \
decomposition is singular at threshold and in the exactly collinear \
configuration, as it must be.\
\>", "Text",ExpressionUUID->"c63de7db-c5e7-44f7-ad82-8ff8c23a4d44"],

Cell[BoxData["Bvec"], "Input",ExpressionUUID->"266cba66-37e9-4d1b-871d-b553fb3731f9"],

Cell[BoxData["Fvec"], "Input",ExpressionUUID->"ef621c04-9c10-4cbb-8bf0-c1cc47f0a830"],

Cell["5. Save", "Section",ExpressionUUID->"25d7e2ec-e771-4a44-a6c5-de8714dbccb4"],

Cell["\<\
The Gram matrix and the two form factors are written as Mathematica \
expressions into the folder ee_pipi next to the notebook (created if needed), \
one file per form factor.\
\>", "Text",ExpressionUUID->"ff04ce0f-8be5-4f89-928c-87a3ebf86c96"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"outDir", " ", "=", " ", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Quiet", "[", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
         RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}], ",", 
      " ", "\"\<ee_pipi\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", " ", 
     RowBox[{"DirectoryQ", "[", "outDir", "]"}]}], ",", " ", 
    RowBox[{"CreateDirectory", "[", "outDir", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Put", "[", 
   RowBox[{"G", ",", " ", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"outDir", ",", " ", "\"\<Gram_Matrix.m\>\""}], "}"}], "]"}]}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Put", "[", 
     RowBox[{
      RowBox[{"Fvec", "[", 
       RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"outDir", ",", " ", 
         RowBox[{"\"\<FF_Tree_\>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", "i", "]"}], " ", "<>", 
          " ", "\"\<.m\>\""}]}], "}"}], "]"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", 
      RowBox[{"Length", "[", "basis", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"FileNames", "[", 
  RowBox[{"\"\<*\>\"", ",", " ", "outDir"}], "]"}]}], "Input",ExpressionUUID->\
"6ac3ccf6-906c-46d4-9e99-499525707a75"]
},
