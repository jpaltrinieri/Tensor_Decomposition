Notebook[{
Cell["Tensor Decomposition for e+e- \[LongRightArrow] \[Pi]+\[Pi]- at LO \
(optimised)", "Title",ExpressionUUID->"eadca010-435b-4e3b-9cd3-f617f3aadaaf"],

Cell["\<\
Scalar QED amplitude for e+(p1) e-(p2) \[LongRightArrow] \[Pi]+(p3) \
\[Pi]-(p4), decomposed onto a basis of two Dirac structures by solving G.F = \
B, where G is the Gram matrix of the basis and B the projection of the \
amplitude onto it. Expected result: F1 = -2e^2/s and F2 = 0 (the scalar \
structure needs a helicity flip and only appears beyond LO).\
\>", "Text",ExpressionUUID->"a46988f8-22d0-49fe-8c3f-68f90f80710c"],

Cell["1. Packages", "Section",ExpressionUUID->"595c3938-ad98-4dd7-8edb-8991f9292e77"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"$FeynCalcStartupMessages", " ", "=", " ", "False"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$LoadAddOns", " ", "=", " ", 
   RowBox[{"{", "\"\<FeynArts\>\"", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Get", "[", "\"\<FeynCalc`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$FAVerbose", " ", "=", " ", "0"}], ";"}]}], "Input",ExpressionUUID->\
"756d394d-d50d-498a-9791-fd788f053d6f"],

Cell["2. Kinematics", "Section",ExpressionUUID->"0cc934b5-eb30-4a0d-8104-d921313a78f0"],

Cell["\<\
SetMandelstam fixes all ten scalar products at once (momenta taken as \
incoming, hence -p3, -p4). The fourth invariant is passed directly as 2me^2 + \
2m\[Pi]^2 - s - t, so u never appears in the results. Masses are kept \
symbolic through FeynCalc's SMP symbols.\
\>", "Text",ExpressionUUID->"8adad98f-9c54-402c-a877-2c4c43175a4c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"FCClearScalarProducts", "[", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"me", " ", "=", " ", 
   RowBox[{"SMP", "[", "\"\<m_e\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mpi", " ", "=", " ", 
   RowBox[{"SMP", "[", "\"\<m_pi\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetMandelstam", "[", 
   RowBox[{"s", ",", " ", "t", ",", " ", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"me", "^", "2"}]}], " ", "+", " ", 
     RowBox[{"2", " ", 
      RowBox[{"mpi", "^", "2"}]}], " ", "-", " ", "s", " ", "-", " ", "t"}], ",",
     " ", "p1", ",", " ", "p2", ",", " ", 
    RowBox[{"-", "p3"}], ",", " ", 
    RowBox[{"-", "p4"}], ",", " ", "me", ",", " ", "me", ",", " ", "mpi", ",",
     " ", "mpi"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", 
   RowBox[{
    RowBox[{"s", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"me", " ", ">", " ", "0"}], " ", "&&", " ", 
    RowBox[{"mpi", " ", ">", " ", "0"}]}]}], ";"}]}], "Input",ExpressionUUID->\
"010d7a25-c1be-432d-bcc0-fa675e5e1a14"],

Cell["3. Amplitude from FeynArts", "Section",ExpressionUUID->"d9a83c18-1348-485a-86cf-3493ded91040"],

Cell["\<\
FeynArts has no built-in scalar QED model. The charged Goldstone boson S[3] \
of the SM model couples to the photon exactly like a charged scalar, so \
excluding the Z, W, Higgs, neutral Goldstone, ghosts, and all other fermions \
leaves pure sQED; the mass is renamed via FinalSubstitutions. The electric \
charge is kept symbolic.\
\>", "Text",ExpressionUUID->"7ac5f68b-80c8-4490-8b93-b9f993fbb675"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tops", " ", "=", " ", 
   RowBox[{"CreateTopologies", "[", 
    RowBox[{"0", ",", " ", 
     RowBox[{"2", " ", "->", " ", "2"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"diags", " ", "=", " ", 
   RowBox[{"InsertFields", "[", 
    RowBox[{"tops", ",", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"F", "[", 
          RowBox[{"2", ",", " ", 
           RowBox[{"{", "1", "}"}]}], "]"}]}], ",", " ", 
        RowBox[{"F", "[", 
         RowBox[{"2", ",", " ", 
          RowBox[{"{", "1", "}"}]}], "]"}]}], "}"}], " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"S", "[", "3", "]"}], ",", " ", 
        RowBox[{"-", 
         RowBox[{"S", "[", "3", "]"}]}]}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"Model", " ", "->", " ", "\"\<SM\>\""}], ",", " ", 
     RowBox[{"InsertionLevel", " ", "->", " ", 
      RowBox[{"{", "Classes", "}"}]}], ",", "\n", "   ", 
     RowBox[{"ExcludeParticles", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"F", "[", "1", "]"}], ",", " ", 
        RowBox[{"F", "[", "3", "]"}], ",", " ", 
        RowBox[{"F", "[", "4", "]"}], ",", " ", 
        RowBox[{"V", "[", "2", "]"}], ",", " ", 
        RowBox[{"V", "[", "3", "]"}], ",", " ", 
        RowBox[{"S", "[", "1", "]"}], ",", " ", 
        RowBox[{"S", "[", "2", "]"}], ",", " ", 
        RowBox[{"U", "[", "1", "]"}], ",", " ", 
        RowBox[{"U", "[", "2", "]"}], ",", " ", 
        RowBox[{"U", "[", "3", "]"}], ",", " ", 
        RowBox[{"U", "[", "4", "]"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Paint", "[", 
   RowBox[{"diags", ",", " ", 
    RowBox[{"ColumnsXRows", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}]}], ",", " ", 
    RowBox[{"Numbering", " ", "->", " ", "None"}], ",", " ", 
    RowBox[{"SheetHeader", " ", "->", " ", "None"}], ",", " ", 
    RowBox[{"ImageSize", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"256", ",", " ", "256"}], "}"}]}]}], "]"}], ";"}]}], "Input",Exp\
ressionUUID->"bc193c2c-921f-4c89-b0e6-5d6afb46af5e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"amp", " ", "=", " ", 
   RowBox[{"FCFAConvert", "[", 
    RowBox[{
     RowBox[{"CreateFeynAmp", "[", "diags", "]"}], ",", "\n", "   ", 
     RowBox[{"IncomingMomenta", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"p1", ",", " ", "p2"}], "}"}]}], ",", " ", 
     RowBox[{"OutgoingMomenta", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"p3", ",", " ", "p4"}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"UndoChiralSplittings", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"ChangeDimension", " ", "->", " ", "4"}], ",", " ", 
     RowBox[{"List", " ", "->", " ", "False"}], ",", " ", 
     RowBox[{"SMP", " ", "->", " ", "True"}], ",", " ", 
     RowBox[{"Contract", " ", "->", " ", "True"}], ",", "\n", "   ", 
     RowBox[{"FinalSubstitutions", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"SMP", "[", "\"\<m_W\>\"", "]"}], " ", "->", " ", "mpi"}], 
       "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"amp", " ", "=", " ", 
  RowBox[{"DiracSimplify", "[", 
   RowBox[{"FeynAmpDenominatorExplicit", "[", "amp", "]"}], "]"}]}]}], "Input",\
ExpressionUUID->"4483b79b-0ed1-4562-bc17-b8f1fb7de0dd"],

Cell["4. Tensor decomposition", "Section",ExpressionUUID->"cd94853e-2600-4060-95b0-7b9fb2bcf460"],

Cell["\<\
Generic helpers: the Gram matrix G_ij = \[Sum]_spins T_i T_j^* and the \
projections B_i = \[Sum]_spins T_i^* M. The form factors follow from \
LinearSolve, which avoids forming the symbolic inverse. Everything is written \
in terms of Length[basis], so adding a structure (e.g. at one loop) needs no \
other change.\
\>", "Text",ExpressionUUID->"54b0c0c7-28fb-48c6-9b2c-4496f2570f2c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"spinSum", "[", "expr_", "]"}], " ", ":=", " ", 
   RowBox[{"DiracSimplify", "[", 
    RowBox[{"FermionSpinSum", "[", "expr", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gramMatrix", "[", "basis_List", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"spinSum", "[", 
      RowBox[{
       RowBox[{"basis", "[", 
        RowBox[{"[", "i", "]"}], "]"}], " ", 
       RowBox[{"ComplexConjugate", "[", 
        RowBox[{"basis", "[", 
         RowBox[{"[", "j", "]"}], "]"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", 
       RowBox[{"Length", "[", "basis", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", 
       RowBox[{"Length", "[", "basis", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"projections", "[", 
    RowBox[{"amp_", ",", " ", "basis_List"}], "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"spinSum", "[", 
      RowBox[{
       RowBox[{"ComplexConjugate", "[", 
        RowBox[{"basis", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], " ", "amp"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", 
       RowBox[{"Length", "[", "basis", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"formFactors", "[", 
    RowBox[{"amp_", ",", " ", "basis_List"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"G", ",", " ", "B"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"G", " ", "=", " ", 
       RowBox[{"Factor", "[", 
        RowBox[{"gramMatrix", "[", "basis", "]"}], "]"}]}], ";", "\n", "   ", 
      
      RowBox[{"B", " ", "=", " ", 
       RowBox[{"Simplify", "[", 
        RowBox[{"projections", "[", 
         RowBox[{"amp", ",", " ", "basis"}], "]"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"G", ",", " ", "B", ",", " ", 
        RowBox[{"Simplify", "[", 
         RowBox[{"LinearSolve", "[", 
          RowBox[{"G", ",", " ", "B"}], "]"}], "]"}]}], "}"}]}]}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"de445f1f-d67c-4a96-90a7-9110e52f69ad"],

Cell["\<\
Basis. GS[p3] is \[Gamma]\[CenterDot]p3 already contracted, so no dummy \
Lorentz index is needed. Only p3 appears because vbar(p1).(p3+p4)slash.u(p2) \
= vbar(p1).(p1+p2)slash.u(p2) = 0 by the Dirac equation, so (p3-p4)slash is \
equivalent to 2 p3slash between these spinors.\
\>", "Text",ExpressionUUID->"4f70f5af-2efd-4015-a8c0-81198db23851"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"vbar", " ", "=", " ", 
   RowBox[{"SpinorVBar", "[", 
    RowBox[{"p1", ",", " ", "me"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"uSp", " ", "=", " ", 
   RowBox[{"SpinorU", "[", 
    RowBox[{"p2", ",", " ", "me"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T1", " ", "=", " ", 
   RowBox[{"vbar", " ", ".", " ", 
    RowBox[{"GS", "[", "p3", "]"}], " ", ".", " ", "uSp"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"T2", " ", "=", " ", 
   RowBox[{"vbar", " ", ".", " ", "uSp"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"basis", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"T1", ",", " ", "T2"}], "}"}]}], ";"}]}], "Input",ExpressionUUID->\
"98d8f724-70e7-46f6-922b-6bbe8c1e295e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"G", ",", " ", "Bvec", ",", " ", "Fvec"}], "}"}], " ", "=", " ", 
   RowBox[{"formFactors", "[", 
    RowBox[{"amp", ",", " ", "basis"}], "]"}]}], ";"}], "\n", 
 RowBox[{"G", " ", "//", " ", "MatrixForm"}]}], "Input",ExpressionUUID->\
"359703f7-3f5d-4551-a11d-a4de87c52e75"],

Cell[BoxData[
 RowBox[{"Factor", "[", 
  RowBox[{"Det", "[", "G", "]"}], "]"}]], "Input",ExpressionUUID->"2b3f2262-\
f8c5-4bd6-82d6-24c6093fc1d2"],

Cell["\<\
The Gram determinant is proportional to the squared momentum of the pion in \
the CM frame, i.e. to s - 4m\[Pi]^2, times the forward/backward factor; the \
decomposition is singular at threshold and in the exactly collinear \
configuration, as it must be.\
\>", "Text",ExpressionUUID->"9aa2cf96-f950-4340-9464-64713eea72ab"],

Cell[BoxData["Bvec"], "Input",ExpressionUUID->"893913eb-ebb2-4470-861b-a54ae0ac1697"],

Cell[BoxData["Fvec"], "Input",ExpressionUUID->"83bff874-1a37-45c6-96ee-dfe9e5072794"],

Cell["5. Save", "Section",ExpressionUUID->"30a359cf-fc10-43e7-8831-368eeeb285db"],

Cell["\<\
The Gram matrix and the two form factors are written as Mathematica \
expressions into the folder ee_pipi next to the notebook (created if needed), \
one file per form factor.\
\>", "Text",ExpressionUUID->"7acdcb72-6673-4204-9f3b-63c462d17fe3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"outDir", " ", "=", " ", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Quiet", "[", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
         RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}], ",", 
      " ", "\"\<ee_pipi\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", " ", 
     RowBox[{"DirectoryQ", "[", "outDir", "]"}]}], ",", " ", 
    RowBox[{"CreateDirectory", "[", "outDir", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Put", "[", 
   RowBox[{"G", ",", " ", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"outDir", ",", " ", "\"\<Gram_Matrix.m\>\""}], "}"}], "]"}]}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Put", "[", 
     RowBox[{
      RowBox[{"Fvec", "[", 
       RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"outDir", ",", " ", 
         RowBox[{"\"\<FF_Tree_\>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", "i", "]"}], " ", "<>", 
          " ", "\"\<.m\>\""}]}], "}"}], "]"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", 
      RowBox[{"Length", "[", "basis", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"FileNames", "[", 
  RowBox[{"\"\<*\>\"", ",", " ", "outDir"}], "]"}]}], "Input",ExpressionUUID->\
"8484dd4e-d448-4af0-b52e-748a022e185d"]
},
